# Benchmark image: release neve binary + lib/audio (FFI) + python (librosa/torchaudio CPU).
# Build (from the repo root):  docker build -f audio_tests/benchmarks/Dockerfile.bench -t neve-audio-bench .
# Run:                      docker run --rm neve-audio-bench
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# base: toolchain da lib.so (clang-21 via apt.llvm.org) + python
RUN apt-get update && apt-get install -y --no-install-recommends \
      git make lsb-release wget software-properties-common gnupg ca-certificates \
      python3 python3-pip python3-venv util-linux bzip2 \
    && rm -rf /var/lib/apt/lists/*

COPY llvm.sh /tmp/llvm.sh
RUN chmod +x /tmp/llvm.sh && /tmp/llvm.sh 21 \
    && apt-get install -y --no-install-recommends clang-21 llvm-21-dev \
    && rm -rf /var/lib/apt/lists/*

# python deps: torch/torchaudio CPU (index proprio, evita wheels CUDA)
COPY audio_tests/benchmarks/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir torch==2.5.1 torchaudio==2.5.1 \
      --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --no-cache-dir -r /tmp/requirements.txt

# runtime neve (release): binary + sys_lib + lib/ (std_lib + audio) + src/ (headers for lib.so)
COPY neve /neve/bin/neve
COPY sys.tar.bz2 /tmp/sys.tar.bz2
RUN tar -xjf /tmp/sys.tar.bz2 -C /neve && rm /tmp/sys.tar.bz2 \
    && chmod +x /neve/bin/neve
COPY lib/ /neve/lib/
COPY src/ /neve/src/

# benchmark (no local data/results: generated by the run)
COPY audio_tests/ /neve/audio_tests/
RUN rm -rf /neve/audio_tests/benchmarks/results /neve/audio_tests/benchmarks/data

ENV NEVE_LIBS=/neve/lib
ENV PATH="/neve/bin:${PATH}"
WORKDIR /neve

CMD ["bash", "audio_tests/benchmarks/run.sh"]
